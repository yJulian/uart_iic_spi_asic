// Gowin physical constraints for tangnano9k_top on the Sipeed Tang Nano 9K
// (GW1NR-LV9QN88PC6/I5, device GW1N-9C, package QN88P).
//
// Pin numbers cross-checked against the official Sipeed TangNano-9K-example
// repo (uart/led/picotiny .cst files) and the board's KiCad schematic.
//
// Every pin gets an explicit IO_TYPE=LVCMOS33: apycula's gowin_pack defaults
// unconstrained pins to LVCMOS18 and aborts with a bank-voltage mismatch as
// soon as one of them shares a bank with a pin that *does* set LVCMOS33.

IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "rst_n" 4;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "spi_sclk" 25;
IO_PORT "spi_sclk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "spi_mosi" 26;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "spi_miso" 27;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "spi_cs_n[0]" 28;
IO_PORT "spi_cs_n[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "spi_cs_n[1]" 29;
IO_PORT "spi_cs_n[1]" IO_TYPE=LVCMOS33 DRIVE=8;

// Open-drain I2C: internal pull-up brings the line high when released.
// For a real bus with more than one device, add external ~4.7k pull-ups.
IO_LOC "i2c_scl" 30;
IO_PORT "i2c_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "i2c_sda" 19;
IO_PORT "i2c_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// Onboard LEDs, active-low.
IO_LOC "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[2]" 13;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[3]" 14;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[4]" 15;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[5]" 16;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;
